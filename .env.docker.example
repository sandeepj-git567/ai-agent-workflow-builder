# Docker Environment Example
PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/ai_workflow_db
PGSSLMODE=disable

HASURA_GRAPHQL_ENDPOINT=http://web:3000/api/graphql
HASURA_GRAPHQL_ADMIN_SECRET=nhost-admin-secret

# LLM Providers (Leave blank for automatic Local Mock LLM fallback)
GROQ_API_KEY=
OPENAI_API_KEY=
