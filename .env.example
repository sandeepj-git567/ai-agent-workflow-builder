# ==============================================================================
# AI Agent Workflow Builder — Environment Configuration
# ==============================================================================

# Server & Application
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (PostgreSQL / Nhost PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflow_builder
PGSSLMODE=disable

# Nhost & Hasura Configuration
NHOST_SUBDOMAIN=local
NHOST_REGION=local
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=local

# Hasura GraphQL Engine Endpoint & Admin Secret
HASURA_GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=nhost-admin-secret
NEXT_PUBLIC_HASURA_GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql
NEXT_PUBLIC_HASURA_ADMIN_SECRET=nhost-admin-secret

# Hasura Action & Webhook Secret
ACTION_SECRET=hasura-action-secret-key-12345
WEBHOOK_SECRET=webhook-secret-key-12345

# LLM Providers (Real APIs)
# Groq (Recommended - Fast & Free tier available at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

# OpenAI (Optional alternative)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Execution Engine Configuration
WORKFLOW_EXECUTION_TIMEOUT_MS=30000
MAX_STEP_RETRIES=2
STEP_RETRY_DELAY_MS=1000
